@using System.Threading

@{
    ViewBag.Title = "مغایرت بانکی";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@functions{
    public string TokenHeaderValue()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}

<link href="~/Content/vendors/select2/dist/css/select2.min.css?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)" rel="stylesheet" />
<link href="~/Content/Customer/Financial/BankReconciliation.css?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)" rel="stylesheet" />

<input type="hidden" id="forgeryToken" value="@TokenHeaderValue()" />

<div class="row" id="bankReconciliationArea">
    <div class="col-12">

        <div class="card br-card">

            <div class="card-header bg-white border-charkheh2 d-flex justify-content-between align-items-center py-1">

                <h6 class="m-0 p-0 color-charkheh2 font-weight-bold">
                    <i class="fas fa-university ml-1"></i>
                    مغایرت بانکی
                </h6>

                <div class="br-header-actions">

                    <button type="button"
                            id="btnRefresh"
                            title="تازه‌سازی"
                            class="btn bg-charkheh2-lighten color-charkheh1 pt-1 pb-0 px-2">
                        <i class="fas fa-sync-alt"></i>
                    </button>

                    <button type="button"
                            id="btnFinalize"
                            title="نهایی‌سازی"
                            class="btn bg-charkheh2-lighten color-charkheh1 pt-1 pb-0 px-2">
                        <i class="fas fa-check ml-1"></i>
                        نهایی‌سازی
                    </button>

                    <button type="button"
                            id="btnHistory"
                            title="سوابق مغایرت‌ها"
                            class="btn bg-charkheh2-lighten color-charkheh1 pt-1 pb-0 px-2">
                        <i class="fas fa-history ml-1"></i>
                        سوابق
                    </button>

                </div>

            </div>

            <div class="card-body py-1">

                <div class="card br-filter-card">

                    <div class="card-body py-2">

                        <div class="row align-items-end">

                            <div class="col-lg-4 col-md-6 col-12">

                                <label for="BankAccountId"
                                       class="select2-label w-100">

                                    حساب بانکی

                                    <select id="BankAccountId"
                                            class="form-control">
                                    </select>

                                </label>

                            </div>

                            <div class="col-lg-3 col-md-3 col-6">

                                <div class="md-form mb-0">

                                    <input type="text"
                                           id="FromDate"
                                           class="form-control"
                                           autocomplete="off">

                                    <label for="FromDate">
                                        از تاریخ
                                    </label>

                                </div>

                            </div>

                            <div class="col-lg-3 col-md-3 col-6">

                                <div class="md-form mb-0">

                                    <input type="text"
                                           id="ToDate"
                                           class="form-control"
                                           autocomplete="off">

                                    <label for="ToDate">
                                        تا تاریخ
                                    </label>

                                </div>

                            </div>

                            <div class="col-lg-2 col-12 mt-lg-0 mt-2">

                                <button type="button"
                                        id="btnLoad"
                                        class="btn btn-charkheh1 w-100 py-2">

                                    <i class="fas fa-search ml-1"></i>
                                    نمایش

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal fade" id="reconciliationHistoryModal" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header py-2">
                                <h6 class="modal-title font-weight-bold color-charkheh2">
                                    <i class="fas fa-history ml-1"></i>
                                    سوابق مغایرت‌های بانکی
                                </h6>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body py-2">
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-0" id="reconciliationHistoryTable">
                                        <thead>
                                            <tr>
                                                <th>حساب بانکی</th>
                                                <th>از تاریخ</th>
                                                <th>تا تاریخ</th>
                                                <th>وضعیت</th>
                                                <th>عملیات</th>
                                            </tr>
                                            <tr class="br-column-filter-row">
                                                <th><input type="text" class="form-control form-control-sm br-history-column-filter" data-filter="BankAccountTitle" placeholder="حساب" /></th>
                                                <th><input type="text" class="form-control form-control-sm br-history-column-filter" data-filter="FromDate" placeholder="از تاریخ" autocomplete="off" /></th>
                                                <th><input type="text" class="form-control form-control-sm br-history-column-filter" data-filter="ToDate" placeholder="تا تاریخ" autocomplete="off" /></th>
                                                <th>
                                                    <select class="form-control form-control-sm br-history-column-filter" data-filter="State">
                                                        <option value="">همه</option>
                                                        <option value="1">نهایی شده</option>
                                                        <option value="0">در حال ویرایش</option>
                                                    </select>
                                                </th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="reconciliationContext" class="br-reconciliation-context d-none">
                    <div class="br-reconciliation-context-main">
                        <i class="fas fa-edit"></i>
                        <strong id="reconciliationContextTitle">مغایرت بانکی</strong>
                        <span id="reconciliationContextDate">-</span>
                        <span id="reconciliationContextState">در حال ویرایش</span>
                    </div>
                    <button type="button" id="btnChangeReconciliation" class="btn btn-sm bg-charkheh2-lighten color-charkheh1">
                        <i class="fas fa-exchange-alt ml-1"></i>
                        تغییر مغایرت
                    </button>
                </div>

                <div class="row mt-2">

                    <div class="col-lg col-md-4 col-6">

                        <div class="card br-summary-card">

                            <div class="card-body py-2">

                                <div class="br-summary-icon">
                                    <i class="fas fa-list"></i>
                                </div>

                                <div class="br-summary-content">

                                    <div class="br-summary-label">
                                        کل تراکنش‌ها
                                    </div>

                                    <div class="br-summary-value"
                                         id="summaryTotal">
                                        0
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg col-md-4 col-6">

                        <div class="card br-summary-card">

                            <div class="card-body py-2">

                                <div class="br-summary-icon">
                                    <i class="fas fa-check-circle"></i>
                                </div>

                                <div class="br-summary-content">

                                    <div class="br-summary-label">
                                        تطبیق شده
                                    </div>

                                    <div class="br-summary-value"
                                         id="summaryMatched">
                                        0
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg col-md-4 col-6">

                        <div class="card br-summary-card">

                            <div class="card-body py-2">

                                <div class="br-summary-icon">
                                    <i class="fas fa-exclamation-circle"></i>
                                </div>

                                <div class="br-summary-content">

                                    <div class="br-summary-label">
                                        نیاز به بررسی
                                    </div>

                                    <div class="br-summary-value"
                                         id="summaryPartial">
                                        0
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg col-md-4 col-6">

                        <div class="card br-summary-card">

                            <div class="card-body py-2">

                                <div class="br-summary-icon">
                                    <i class="fas fa-times-circle"></i>
                                </div>

                                <div class="br-summary-content">

                                    <div class="br-summary-label">
                                        عدم تطبیق
                                    </div>

                                    <div class="br-summary-value"
                                         id="summaryUnmatched">
                                        0
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg col-md-4 col-6">

                        <div class="card br-summary-card">

                            <div class="card-body py-2">

                                <div class="br-summary-icon">
                                    <i class="fas fa-coins"></i>
                                </div>

                                <div class="br-summary-content">

                                    <div class="br-summary-label">
                                        مانده تطبیق
                                    </div>

                                    <div class="br-summary-value"
                                         id="summaryRemaining">
                                        0
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card br-progress-card mt-2">

                    <div class="card-body py-2">

                        <div class="d-flex justify-content-between align-items-center mb-1">

                            <span class="br-progress-title">
                                درصد تطبیق
                            </span>

                            <span class="br-progress-percent"
                                  id="matchPercentage">
                                0%
                            </span>

                        </div>

                        <div class="progress br-progress">

                            <div id="matchProgress"
                                 class="progress-bar bg-charkheh2"
                                 role="progressbar"
                                 style="width:0%">
                            </div>

                        </div>

                        <div class="d-flex justify-content-between mt-1 br-progress-info">

                            <span id="matchProgressText">
                                0 از 0 تراکنش تطبیق شده
                            </span>

                            <span id="remainingText">
                                0 مورد باقی‌مانده
                            </span>

                        </div>

                    </div>

                </div>



                <div class="br-workspace">

                    <div class="br-bank-pane">
                <div class="card br-transactions-card">

                    <div class="card-header bg-white border-charkheh2 d-flex justify-content-between align-items-center py-0">

                        <div class="classic-tabs br-tabs-wrapper">

                            <ul class="nav bg-charkheh2-lighten br-tabs"
                                role="tablist">

                                <li class="nav-item">

                                    <a class="nav-link br-tab active"
                                       data-status="all"
                                       href="javascript:void(0);">

                                        همه

                                        <span id="tabAllCount"
                                              class="badge br-tab-badge">
                                            0
                                        </span>

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link br-tab"
                                       data-status="matched"
                                       href="javascript:void(0);">

                                        تطبیق شده

                                        <span id="tabMatchedCount"
                                              class="badge br-tab-badge">
                                            0
                                        </span>

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link br-tab"
                                       data-status="partial"
                                       href="javascript:void(0);">

                                        نیاز به بررسی

                                        <span id="tabPartialCount"
                                              class="badge br-tab-badge">
                                            0
                                        </span>

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link br-tab"
                                       data-status="unmatched"
                                       href="javascript:void(0);">

                                        عدم تطبیق

                                        <span id="tabUnmatchedCount"
                                              class="badge br-tab-badge">
                                            0
                                        </span>

                                    </a>

                                </li>

                            </ul>

                        </div>

                        <div class="br-transaction-tools">

                            <div class="input-group br-search">

                                <input type="text"
                                       id="txtSearch"
                                       class="form-control"
                                       placeholder="جستجو..." />

                                <div class="input-group-append">

                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>

                                </div>

                            </div>

                            <button type="button"
                                    id="btnAutoMatch"
                                    class="btn bg-charkheh2-lighten color-charkheh1">

                                <i class="fas fa-magic ml-1"></i>
                                تطبیق خودکار

                            </button>

                        </div>

                    </div>

                    <div class="card-body py-1">

                        <div class="br-section-title">

                            <div>
                                <i class="fas fa-university ml-1"></i>
                                تراکنش‌های بانکی
                            </div>

                            <div class="br-section-tools">
                                <button type="button" id="btnClearBankFilters" class="btn btn-sm br-clear-filters">
                                    <i class="fas fa-eraser ml-1"></i>
                                    پاک کردن فیلترها
                                </button>
                                <span id="bankCount"
                                      class="badge bg-charkheh2 color-white">
                                    0
                                </span>
                            </div>

                        </div>

                        <div class="br-table-container">

                            <table id="bankTransactions"
                                   class="table table-hover table-striped table-bordered w-100">

                                <thead>

                                    <tr>

                                        <th>
                                            ردیف
                                        </th>

                                        <th>
                                            تاریخ
                                        </th>

                                        <th>
                                            شرح
                                        </th>

                                        <th>
                                            نوع
                                        </th>

                                        <th>
                                            پیگیری
                                        </th>

                                        <th>
                                            مبلغ
                                        </th>

                                        <th>
                                            مانده حساب
                                        </th>

                                        <th>
                                            مانده تطبیق
                                        </th>

                                        <th>
                                            وضعیت
                                        </th>

                                    </tr>

                                                                        <tr class="br-column-filter-row">
                                        <th></th>
                                        <th><input type="text" id="bankFilterTransactionDate" class="form-control form-control-sm br-column-filter" data-filter="TransactionDate" placeholder="تاریخ" autocomplete="off" /></th>
                                        <th><input type="text" class="form-control form-control-sm br-column-filter" data-filter="Description" placeholder="شرح" /></th>
                                        <th><select class="form-control form-control-sm br-column-filter" data-filter="Type"><option value="">همه</option><option value="واریز">واریز</option><option value="برداشت">برداشت</option></select></th>
                                        <th><input type="text" class="form-control form-control-sm br-column-filter" data-filter="TrackingNumber" placeholder="پیگیری" /></th>
                                        <th><input type="text" inputmode="decimal" class="form-control form-control-sm br-column-filter br-numeric-filter" data-filter="Amount" placeholder="مبلغ" /></th>
                                        <th><input type="text" inputmode="decimal" class="form-control form-control-sm br-column-filter br-numeric-filter" data-filter="Balance" placeholder="مانده" /></th>
                                        <th><input type="text" inputmode="decimal" class="form-control form-control-sm br-column-filter br-numeric-filter" data-filter="RemainingAmount" placeholder="مانده تطبیق" /></th>
                                        <th><select class="form-control form-control-sm br-column-filter" data-filter="Status"><option value="">همه</option><option value="2">تطبیق شده</option><option value="1">نیاز به بررسی</option><option value="0">عدم تطبیق</option></select></th>

                                </thead>

                                <tbody>
                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

                    </div>

                    <div class="br-match-pane">
                <div class="card br-match-card">

                    <div class="card-header bg-white border-charkheh2 d-flex justify-content-between align-items-center py-1">

                        <h6 class="m-0 p-0 color-charkheh2 font-weight-bold">

                            <i class="fas fa-random ml-1"></i>
                            عملیات تطبیق

                        </h6>

                        <div class="br-match-score">

                            <span id="matchScoreLabel">
                                وضعیت تطبیق
                            </span>

                            <strong id="matchScore">
                                -
                            </strong>

                        </div>

                    </div>

                    <div class="card-body py-1">

<div class="br-selected-transaction">

                            <div class="br-selected-title">
                                <i class="fas fa-hand-pointer ml-1"></i>
                                تراکنش انتخاب‌شده
                            </div>

                            <div class="br-selected-values">

                                <div class="br-selected-item">
                                    <span>تاریخ</span>
                                    <strong id="selectedTransactionDate">-</strong>
                                </div>

                                <div class="br-selected-item br-selected-description">
                                    <span>شرح</span>
                                    <strong id="selectedTransactionDescription">تراکنشی انتخاب نشده است</strong>
                                </div>

                                <div class="br-selected-item">
                                    <span>مبلغ</span>
                                    <strong id="selectedTransactionAmount">-</strong>
                                </div>

                                <div class="br-selected-item">
                                    <span>مانده تطبیق</span>
                                    <strong id="selectedTransactionRemaining">-</strong>
                                </div>

                            </div>

                        </div>

                        <div class="br-match-actions">

                            <button type="button"
                                    id="btnMatch"
                                    class="btn btn-charkheh1"
                                    disabled>

                                <i class="fas fa-link ml-1"></i>
                                تطبیق

                            </button>

                            <button type="button"
                                    id="btnGroupMatch"
                                    class="btn bg-charkheh2-lighten color-charkheh1"
                                    disabled>

                                <i class="fas fa-object-group ml-1"></i>
                                تطبیق گروهی

                            </button>

                            <button type="button"
                                    id="btnOtherMatch"
                                    class="btn btn-light"
                                    disabled>

                                <i class="fas fa-search ml-1"></i>
                                سایر موارد

                            </button>

                            <button type="button"
                                    id="btnRemoveMatch"
                                    class="btn btn-light"
                                    disabled>

                                <i class="fas fa-unlink ml-1"></i>
                                حذف تطبیق

                            </button>

                        </div>

                    </div>

                </div>

                <div class="card br-candidates-card">

                    <div class="card-header bg-white border-charkheh2 d-flex justify-content-between align-items-center py-1">

                        <h6 class="m-0 p-0 color-charkheh2 font-weight-bold">

                            <i class="fas fa-file-invoice-dollar ml-1"></i>
                            اسناد مالی قابل تطبیق

                        </h6>

                        <div class="d-flex align-items-center">

                            <label for="candidateDateTolerance"
                                   class="mb-0 ml-2 small text-muted">
                                اختلاف تاریخ
                            </label>

                            <select id="candidateDateTolerance"
                                    class="form-control form-control-sm br-date-tolerance">
                                <option value="0" selected>بدون اختلاف</option>
                                <option value="1">۱ روز</option>
                                <option value="2">۲ روز</option>
                            </select>

                        </div>

                        <span id="candidateCount"
                              class="badge bg-charkheh2 color-white">
                            0
                        </span>

                    </div>

                    <div class="card-body py-1">

                        <div class="br-table-container">

                            <table id="accountingCandidates"
                                   class="table table-hover table-striped table-bordered w-100">

                                <thead>

                                    <tr>

                                        <th>
                                            ردیف
                                        </th>

                                        <th>
                                            تاریخ
                                        </th>

                                        <th>
                                            شماره سند
                                        </th>

                                        <th>
                                            حساب
                                        </th>

                                        <th>
                                            مراکز حساب
                                        </th>

                                        <th>
                                            شرح
                                        </th>

                                        <th>
                                            نوع
                                        </th>

                                        <th>
                                            پیگیری
                                        </th>

                                        <th>
                                            مبلغ
                                        </th>

                                        <th>
                                            اختلاف مبلغ
                                        </th>

                                    </tr>

                                                                        <tr class="br-column-filter-row">
                                        <th></th>
                                        <th><input type="text" id="candidateFilterAccountingDocDate" class="form-control form-control-sm br-column-filter" data-filter="AccountingDocDate" placeholder="تاریخ" autocomplete="off" /></th>
                                        <th><input type="text" inputmode="numeric" class="form-control form-control-sm br-column-filter br-numeric-filter" data-filter="AccountingDocId" placeholder="شماره" /></th>
                                        <th><input type="text" class="form-control form-control-sm br-column-filter" data-filter="AccountTitle" placeholder="حساب" /></th>
                                        <th><input type="text" class="form-control form-control-sm br-column-filter" data-filter="CenterTitle" placeholder="مرکز" /></th>
                                        <th><input type="text" class="form-control form-control-sm br-column-filter" data-filter="Description" placeholder="شرح" /></th>
                                        <th><select class="form-control form-control-sm br-column-filter" data-filter="TrackingSource"><option value="">همه</option><option value="DepositSlip">فیش واریز</option><option value="Cheque">چک</option><option value="DepositSlip, Cheque">فیش واریز / چک</option></select></th>
                                        <th><input type="text" class="form-control form-control-sm br-column-filter" data-filter="TrackingNumber" placeholder="پیگیری" /></th>
                                        <th><input type="text" inputmode="decimal" class="form-control form-control-sm br-column-filter br-numeric-filter" data-filter="Amount" placeholder="مبلغ" /></th>
                                        <th><input type="text" inputmode="decimal" class="form-control form-control-sm br-column-filter br-numeric-filter" data-filter="AmountDifference" placeholder="اختلاف" /></th>
                                    </tr>

                                </thead>

                                <tbody>
                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

<script src="~/Scripts/vendors/select2/dist/js/select2.full.min.js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>
<script src="~/Scripts/vendors/select2/dist/js/select2.@(Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName).js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>



<script src="~/Scripts/DataTables/media/js/jquery.dataTables.min.js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>
<script src="~/Scripts/DataTables/extensions/Select/js/dataTables.select.min.js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>
<script src="~/Scripts/DataTables/extensions/Buttons/js/dataTables.buttons.min.js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>
<script src="~/Scripts/DataTables/extensions/Buttons/js/buttons.print.min.js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>
<script src="~/Scripts/DataTables/extensions/Buttons/js/buttons.html5.min.js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>
<script src="~/Scripts/DataTables/dataTables-@(Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName).js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>
<script src="~/Scripts/DataTables/JSZip-2.5.0/jszip.min.js?v=@(ViewContext.Controller.GetType().Assembly.GetName().Version)"></script>


